# CI-only project configuration — committed on purpose, unlike .env
# (gitignored, cpp-plugin/.gitignore). build.yml's "Load .env" steps fall
# back to this file whenever .env is absent, which it always is on a CI
# runner (a fresh checkout, never carries local dotfiles). Contains no
# secrets: signing credentials are supplied via GitHub Actions Secrets
# (see the juce-dev:ci skill's secret-name-mapping table), never via this
# file, by design — keep it that way if this file is ever edited.

# Project Configuration
PROJECT_NAME=Pitchzazz
PRODUCT_NAME="Pitchzazz"
PROJECT_BUNDLE_ID=com.mattfredrick.Pitchzazz
DEVELOPER_NAME="Matt Fredrick"

# JUCE Plugin Codes
PLUGIN_CODE=PIHZ
PLUGIN_MANUFACTURER_CODE=MAFR

# Version Information — kept in step with .env by hand for now; if these
# drift, CI will just build/release whatever version this file says.
VERSION_MAJOR=1
VERSION_MINOR=0
VERSION_PATCH=62
VERSION_BUILD=63

# Feature Flags
USE_VISAGE_UI=FALSE

# DiagnosticKit Settings (not enabled)
ENABLE_DIAGNOSTICS=false

# CI platforms (.github/workflows/build.yml) — macOS + Windows releases
# for interviewers to download, per project direction 2026-08-20. No
# signing certs configured (see the Secrets table in the juce-dev:ci
# skill), so CI builds/releases are unsigned — acceptable for this
# audience.
CI_PLATFORMS="macos,windows"

# JUCE Configuration — pinned, matching .env; see that file's own comment
# for why (a major-version bump wasn't worth the risk this close to a
# deadline).
JUCE_REPO=https://github.com/juce-framework/JUCE.git
JUCE_TAG=8.0.10
